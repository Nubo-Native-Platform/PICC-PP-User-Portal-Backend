# ==============================================================================
# PICC-PP-User-Portal-Backend - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific values.
# Do NOT commit '.env' or real credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Port on which the Spring Boot microservice listens (Default: 8080)
SERVER_PORT=8080

# Active Spring Profile (e.g., dev, main, local)
SPRING_PROFILES_ACTIVE=dev

# CORS Allowed Origins (comma-separated)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ------------------------------------------------------------------------------
# 2. Database Configurations (PostgreSQL)
# ------------------------------------------------------------------------------
# Primary Database (portal schema)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nnp_portal?currentSchema=portal
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=yourSecretPostgresPassword

# DevSecOps Database
SPRING_DATASOURCE_DEVSECOPS_URL=jdbc:postgresql://localhost:5432/nnp_devsecops
SPRING_DATASOURCE_DEVSECOPS_USERNAME=postgres
SPRING_DATASOURCE_DEVSECOPS_PASSWORD=yourSecretPostgresPassword

# ApiEcosystem Database
SPRING_DATASOURCE_APIECOSYSTEM_URL=jdbc:postgresql://localhost:5432/nnp_apiecosystem
SPRING_DATASOURCE_APIECOSYSTEM_USERNAME=postgres
SPRING_DATASOURCE_APIECOSYSTEM_PASSWORD=yourSecretPostgresPassword

# ------------------------------------------------------------------------------
# 3. Redis Cache Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Apache Kafka Streaming
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_REQUEST_TIMEOUT_MS=99999
KAFKA_TOPIC_PODUSAGE=nnp-pod-usage
KAFKA_TOPIC_METRICPREDICTION=nnp-metric-prediction

# ------------------------------------------------------------------------------
# 5. Observability & Telemetry Endpoints
# ------------------------------------------------------------------------------
# SigNoz APM
SIGNOZ_URL=http://localhost:3301
SIGNOZ_API_KEY=yourSecretSigNozApiKey

# Prometheus Metrics
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_STUB_ENABLED=false

# Loki Log Aggregation
LOKI_URL=http://localhost:3100

# ------------------------------------------------------------------------------
# 6. External Integrations
# ------------------------------------------------------------------------------
# Redmine Issue Tracking
REDMINE_URL=http://localhost:3000
REDMINE_API_KEY=yourSecretRedmineApiKey
REDMINE_BASE_PROJECT_ID=nnp-support

# Kubernetes Integration Service
K8SINTG_SERVICE_URL=http://localhost:8082

# ------------------------------------------------------------------------------
# 7. Spring Cloud Config Server (Optional)
# ------------------------------------------------------------------------------
CONFIG_SERVER_URL=http://localhost:8888
CONFIG_LABEL=v1

# ------------------------------------------------------------------------------
# 8. Schedulers & Background Tasks
# ------------------------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_USAGE_DATA_ENABLED=true
SCHEDULER_USAGE_DATA_CRON=0 0 * * * *
SCHEDULER_LOGS_DATA_ENABLED=true
SCHEDULER_LOGS_DATA_CRON=0 0 * * * *
SCHEDULER_PIPELINE_DATA_ENABLED=true
SCHEDULER_PIPELINE_DATA_CRON=0 0 * * * *
SCHEDULER_APIGATEWAY_DATA_ENABLED=true
SCHEDULER_APIGATEWAY_DATA_CRON=0 0 * * * *
SCHEDULER_POD_USAGE_DATA_ENABLED=true
SCHEDULER_POD_USAGE_DATA_CRON=0 * * * * *
SCHEDULER_POD_USAGE_CHUNKING_ENABLED=true
SCHEDULER_POD_USAGE_CHUNKING_NAMESPACES=nnp-core-components
SCHEDULER_POD_USAGE_CHUNKING_BATCH_SIZE=1
SCHEDULER_POD_USAGE_CHUNKING_DELAY_MS=1000
SCHEDULER_POD_USAGE_CHUNKING_WINDOW_MS=60000
PREDICTION_TEST_SCHEDULER_ACTIVE=false

# ------------------------------------------------------------------------------
# 9. Logging & Diagnostics
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
